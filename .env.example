# 本機直接執行後端時主機用 localhost。
# 用 docker compose 啟動時，compose 會把容器裡的主機改成 postgres，這裡不用改。
DATABASE_URL=postgresql+psycopg://aipe04:aipe04@localhost:5432/aipe04

# 自動測試專用。名稱必須以 _test 結尾，驗證程式會清除裡面的資料。
TEST_DATABASE_URL=postgresql+psycopg://aipe04:aipe04@localhost:5432/aipe04_test

# 本機自行換成隨機長字串；正式環境不可沿用範例值。
SESSION_SECRET_KEY=replace-with-a-long-random-string

# 管理員帳號
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin

# demo 老師、學生帳號：已綁定同一門課，附對話與約課紀錄（雲端不要設）
DEMO_TEACHER_EMAIL=teacher@example.com
DEMO_TEACHER_PASSWORD=teacher
DEMO_STUDENT_EMAIL=student@example.com
DEMO_STUDENT_PASSWORD=student

# 個人金鑰
GEMINI_API_KEY=改成個人金鑰

# LLM：練習回饋、課前摘要用來寫文字。沒有金鑰或呼叫失敗時，改用依分數產生的簡短說明。
# 全站預設用哪家（gemini 或 openai），沒寫就是 gemini
LLM_PROVIDER=gemini
# 只換練習回饋，例如改用 openai；課前摘要仍照 LLM_PROVIDER
PRACTICE_FEEDBACK_LLM_PROVIDER=
# AI 出題用哪家，沒寫就是 openai（要有 OPENAI_API_KEY）；不跟 LLM_PROVIDER
QUIZ_GENERATION_LLM_PROVIDER=
# 也可以寫 local：改用 Ollie 電腦上的千問等本機模型（經過 AI 找課同一個閘道，要設 AI_COURSE_GATEWAY_URL、AI_COURSE_GATEWAY_TOKEN）
# 例如 PRACTICE_FEEDBACK_LLM_PROVIDER=local、QUIZ_GENERATION_LLM_PROVIDER=local
# 只換某個功能用的模型（模型要先在閘道的 AI_GATEWAY_CHAT_MODELS 開放）；local 沒寫就是 qwen3:4b-instruct-2507-q4_K_M
QUIZ_GENERATION_LLM_MODEL=
PRACTICE_FEEDBACK_LLM_MODEL=
LOCAL_MODEL=
# 不寫就用預設模型（Gemini：gemini-3.8-flash；OpenAI：gpt-4o-mini）
GEMINI_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
# 每次最多等幾秒；逾時或服務忙碌會再試一次
LLM_TIMEOUT_SECONDS=20

# AI 找課的需求解析改用 QLoRA 微調過的千問（選用）。要先把模型匯入 Ollama，並在閘道的 AI_GATEWAY_CHAT_MODELS 開放。
# 沒設定時用原本的規則解析。做法見 docs/ai-course-finder/開發紀錄.md 的 P6。
COURSE_PARSER_LLM_MODEL=
